<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_customer_breakdown" model="mail.template">
            <field name="name">Customer Breakdown Email</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">{{ object.company_id.name }} Customer Breakdown Information (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent manually to the customer with a breakdown of the opportunity</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_name or 'Customer'">Customer</t>,
        <br/><br/>
        Please find the customer breakdown information below:
        <br/><br/>
        Opportunity: <span style="font-weight:bold;" t-out="object.name or ''">P00015</span>
        <br/>
        Customer: <span style="font-weight:bold;" t-out="object.partner_name or ''">Customer Name</span>
        <br/>
        Stage: <span style="font-weight:bold;" t-out="object.stage_id.name or ''">New</span>
        <br/><br/>
        We are happy to provide any further details on your request.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <br/><br/>
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
        <t t-else="">
            <br/><br/>
            Best regards,<br/>
            <t t-out="user.name or ''">User</t>
        </t>
        <br/><br/>
    </p>
</div></field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="email_template_customer_without_breakdown" model="mail.template">
            <field name="name">Customer Without Breakdown Email</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">{{ object.company_id.name }} Customer Information (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent manually to the customer without a breakdown of the opportunity</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_name or 'Customer'">Customer</t>,
        <br/><br/>
        Thank you for your interest. Here is the customer information:
        <br/><br/>
        Opportunity: <span style="font-weight:bold;" t-out="object.name or ''">P00015</span>
        <br/>
        Customer: <span style="font-weight:bold;" t-out="object.partner_name or ''">Customer Name</span>
        <br/><br/>
        Please let us know if you need any additional details.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <br/><br/>
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
        <t t-else="">
            <br/><br/>
            Best regards,<br/>
            <t t-out="user.name or ''">User</t>
        </t>
        <br/><br/>
    </p>
</div></field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>